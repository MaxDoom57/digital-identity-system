{
  "name": "digital-identity-caliper-benchmarks",
  "version": "1.0.0",
  "description": "Hyperledger Caliper benchmarks for the Digital Identity System thesis (Section 7)",
  "private": true,
  "scripts": {
    "benchmark": "caliper launch manager --caliper-workspace . --caliper-benchconfig benchmark-config.yaml --caliper-networkconfig network-config.yaml",
